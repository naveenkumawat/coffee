<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{REQUEST_URI} ^/coffee/public(/.*)?$ [NC]
    RewriteRule ^ public%1 [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{DOCUMENT_ROOT}/coffee/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/coffee/public/$1 -d
    RewriteRule ^(.*)$ public/$1/ [L]

    RewriteRule ^ index.php [L]
</IfModule>
