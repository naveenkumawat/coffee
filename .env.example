APP_NAME=The88Coffees
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/coffee

# Production (set on the live host — never commit real values):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# APP_SEND_HSTS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
# Production: LOG_LEVEL=warning (or error) and keep APP_DEBUG=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coffee
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty/null for host-only cookies. Do not set to "localhost" or a LAN IP.
SESSION_DOMAIN=null
# false for local/LAN HTTP; true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production sibling hosts example:
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Default disk for Storage:: — keep "local" (private root) so payment proofs stay private.
# Public catalog/website media uses COFFEE_MEDIA_DISK=public + php artisan storage:link.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# App listeners currently run sync; database queue is fine for future jobs.
# Production: keep QUEUE_CONNECTION=database|redis if you introduce workers; sync is acceptable until then.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production: configure a real MAIL_MAILER (smtp/ses/postmark) — password resets need outbound mail.

COFFEE_MENU_CACHE_TTL=15
COFFEE_PWA_URL=http://localhost:4173
# Production: COFFEE_PWA_URL=https://app.example.com  (PWA origin, used in customer links/emails)
COFFEE_PAYMENT_DISPLAY_NAME="${APP_NAME}"
COFFEE_PAYMENT_INSTRUCTIONS="Please complete the payment and share your payment screenshot with the order number on WhatsApp."
COFFEE_UPI_ID=
COFFEE_PAYMENT_PHONE=
COFFEE_PAYMENT_QR_IMAGE_PATH=
COFFEE_PAYMENT_PROOF_MAX_KB=5120
COFFEE_MEDIA_DISK=public
COFFEE_MEDIA_MAX_KB=512
COFFEE_WHATSAPP_NUMBER=
COFFEE_DELIVERY_DISCLAIMER="Delivery will be arranged through a third-party service. Delivery charges are payable separately by the customer."
# Prefer Website Settings for live café payment/contact content; COFFEE_* remain infrastructure fallbacks.

# Host:port only (no scheme). Include every PWA origin you use for Sanctum SPA auth.
# Example LAN: add your-lan-ip:4173 when previewing via http://YOUR_LAN_IP:4173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4173,127.0.0.1,127.0.0.1:4173
# Production example (no scheme): app.example.com,www.app.example.com
# Full origins with scheme. Must match browser Origin exactly. Never use * with credentials.
# Example LAN: http://YOUR_LAN_IP:4173
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Production example: https://app.example.com,https://www.app.example.com
# Host consistency: do not mix www/non-www or localhost vs LAN IP inside one auth session unless both are listed.
# Behind a reverse proxy / load balancer, set TRUSTED_PROXIES=* or a comma-separated IP list.
# TRUSTED_PROXIES=*

# Optional Owner bootstrap on `php artisan db:seed` (production-safe; not demo customers).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
