# Customer PWA → Laravel API (include /api/v1, no trailing slash required).
# On local/LAN the hostname is rewritten to match the address bar (localhost vs 192.168.x.x).
# Ports may differ (PWA :4173, Apache :80); CSRF uses cookie and/or X-CSRF-TOKEN header.
# LAN example: VITE_API_BASE_URL=http://192.168.0.10/coffee/api/v1
VITE_API_BASE_URL=http://localhost/coffee/api/v1
