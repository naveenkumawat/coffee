# Customer PWA → Laravel API (include /api/v1; trailing slash optional).
#
# Local / LAN preview:
#   VITE_API_BASE_URL=http://localhost/coffee/api/v1
#   On local/LAN the client may rewrite the hostname to match the address bar
#   (localhost vs 192.168.x.x). Ports may differ (PWA :4173, Apache :80).
#
# Production build (required absolute HTTPS backend):
#   VITE_API_BASE_URL=https://api.example.com/api/v1
#   VITE_ENFORCE_PRODUCTION_API=1 npm run build
#
# CSRF uses {API origin without /api/v1}/sanctum/csrf-cookie.
# Never bake localhost/LAN into a real production release.
VITE_API_BASE_URL=http://localhost/coffee/api/v1

# R1 realtime (Laravel Reverb). Requires `php artisan reverb:start` on the API host.
# Concrete values only — Vite does not expand Laravel ${REVERB_*} references.
# Keep host family consistent with the browser address bar (all localhost or all LAN IP).
# VITE_REALTIME_ENABLED=true
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
